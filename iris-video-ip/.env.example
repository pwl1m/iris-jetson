# Host file paths only. Never put the RTSP URI or token in this file.
IRIS_IP_RTSP_SECRET_FILE=/etc/iris-ip/camera_rtsp
IRIS_IP_TOKEN_SECRET_FILE=/etc/iris-ip/engine_token
IRIS_IP_GO2RTC_SECRET_FILE=/etc/iris-ip/go2rtc.yaml
IRIS_IP_CAMERA_ID=entrada
IRIS_IP_API_PORT=8181
IRIS_IP_PREVIEW_PORT=1985
IRIS_IP_FRAME_FORMAT=NV12
IRIS_IP_OUTPUT_FPS=1
# Pin an approved compatible digest before production promotion.
IRIS_IP_BASE_IMAGE=nvcr.io/nvidia/deepstream:7.1-samples-multiarch
