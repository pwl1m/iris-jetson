# Runtime target: notebook | jetson
TARGET=jetson

# Camera source
CAMERA_NAME=entrada
# Notebook: webcam interna.
# Jetson: Logitech C930e ou outra USB camera.
# Mapeie cada CAMERA_n_DEVICE para o no V4L2 correspondente.
CAMERA_1_ID=entrada
CAMERA_1_STREAM_URL=rtsp://iris-go2rtc:8554/usb_camera_1
CAMERA_1_PUBLIC_STREAM_URL=
# Enderecos de visualizacao por contexto. PUBLIC_STREAM_URL continua como
# fallback LAN legado durante a migracao; nao registre IPs reais neste arquivo.
CAMERA_1_LAN_STREAM_URL=
CAMERA_1_TAILSCALE_STREAM_URL=
CAMERA_1_ENABLED=true
CAMERA_1_SOURCE_KIND=jetson_gst_usb
CAMERA_1_HOST_DEVICE=/dev/v4l/by-id/usb-046d_Logitech_Webcam_C930e_BF4B1A9E-video-index0
CAMERA_1_DEVICE=/dev/iris-entrada
CAMERA_1_SERIAL=BF4B1A9E
CAMERA_1_MODEL=Logitech Webcam C930e
CAMERA_1_STABLE_PATH=/dev/v4l/by-id/usb-046d_Logitech_Webcam_C930e_BF4B1A9E-video-index0
CAMERA_1_INDEX=0
CAMERA_2_ID=entrada_2
CAMERA_2_STREAM_URL=rtsp://iris-go2rtc:8554/usb_camera_2
CAMERA_2_PUBLIC_STREAM_URL=
CAMERA_2_LAN_STREAM_URL=
CAMERA_2_TAILSCALE_STREAM_URL=
CAMERA_2_ENABLED=true
CAMERA_2_SOURCE_KIND=jetson_gst_usb
CAMERA_2_HOST_DEVICE=/dev/v4l/by-id/usb-046d_Logitech_Webcam_C930e_A0E94A9E-video-index0
CAMERA_2_DEVICE=/dev/iris-entrada-2
CAMERA_2_SERIAL=A0E94A9E
CAMERA_2_MODEL=Logitech Webcam C930e
CAMERA_2_STABLE_PATH=/dev/v4l/by-id/usb-046d_Logitech_Webcam_C930e_A0E94A9E-video-index0
CAMERA_2_INDEX=2
# Slots 3-4 permanecem desabilitados ate que uma camera aprovada seja definida.
CAMERA_3_ID=entrada_3
CAMERA_3_STREAM_URL=
CAMERA_3_PUBLIC_STREAM_URL=
CAMERA_3_LAN_STREAM_URL=
CAMERA_3_TAILSCALE_STREAM_URL=
CAMERA_3_ENABLED=false
CAMERA_3_SOURCE_KIND=
CAMERA_3_DEVICE=
CAMERA_4_ID=entrada_4
CAMERA_4_STREAM_URL=
CAMERA_4_PUBLIC_STREAM_URL=
CAMERA_4_LAN_STREAM_URL=
CAMERA_4_TAILSCALE_STREAM_URL=
CAMERA_4_ENABLED=false
CAMERA_4_SOURCE_KIND=
CAMERA_4_DEVICE=
USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_INDEX=0
USB_CAMERA_INPUT_FORMAT=mjpeg
USB_CAMERA_WIDTH=1920
USB_CAMERA_HEIGHT=1080
USB_CAMERA_FPS=15

# Publicacao MQTT opcional. O Iris so publica se MQTT_PUBLISH_ENABLED=true.
# Para consumidores locais, use MQTT_PUBLISH_HOST=iris-mosquitto. Para a
# integracao central, informe o hostname do broker central. Nao use credenciais
# reais neste arquivo.
MQTT_PUBLISH_ENABLED=false
MQTT_PUBLISH_HOST=
MQTT_PUBLISH_PORT=1883
MQTT_PUBLISH_USERNAME=
MQTT_PUBLISH_PASSWORD=
MQTT_PUBLISH_CLIENT_ID=
MQTT_PUBLISH_TOPIC_PREFIX=iris
MQTT_PUBLISH_QOS=1
MQTT_PUBLISH_QUEUE_SIZE=500
MQTT_PUBLISH_KEEPALIVE_SECONDS=30
# Debounce por sujeito/camera: suprime re-publicacao do mesmo sujeito dentro da janela (segundos).
# 0 = desabilitado. Para 300 Jetsons, manter >= 30 para controlar volume no broker.
MQTT_DEBOUNCE_SECONDS=30

# Vision app
FACE_DB_PATH=/data/faces/faces.sqlite3
FACE_MODEL_NAME=buffalo_m
FACE_MODEL_ROOT=/models/face
FACE_DET_SIZE=480,480
FACE_CTX_ID=0
FACE_TRT_FP16=true
FACE_TRT_ENGINE_CACHE_PATH=/data/trt-engines
FACE_SIMILARITY_THRESHOLD=0.55
FACE_MAX_RESULTS=5
FACE_PROVIDERS=TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider

# Worker behavior
WORKER_LOG_LEVEL=INFO
EVENT_LOG_PATH=/data/events/recognitions.jsonl
OCCLUSION_LOG_PATH=/data/events/occlusions.jsonl
CAPTURE_DIR=/data/events/captures
FACE_CROP_DIR=/data/events/faces
STREAM_URL=rtsp://iris-go2rtc:8554/usb_camera
STREAM_SOURCE_KIND=jetson_gst_usb
STREAM_GST_PIPELINE=
STREAM_WORKER_ENABLED=true
# Production MQTT ingest: keep event volume bounded. Lower only after sizing DB/consumer.
# With 300 Jetsons and MQTT_DEBOUNCE_SECONDS=30, max ~500 msgs/min at broker vs ~5000 without debounce.
STREAM_CAPTURE_INTERVAL_SECONDS=3.0
STREAM_RECONNECT_DELAY_SECONDS=3.0
STREAM_JPEG_QUALITY=85
STREAM_MIN_FACE_SCORE=0.5
STREAM_MAX_CAPTURE_FILES=2000
STREAM_CAPTURE_RETENTION_HOURS=48.0
STREAM_PREVIEW_UPDATE_INTERVAL_SECONDS=0.25
STREAM_PREVIEW_ENABLED=true
STREAM_PREVIEW_MAX_WIDTH=640
STREAM_PREVIEW_JPEG_QUALITY=70
STREAM_READER_BUFFER_SIZE=1
STREAM_SOURCE_READY_TIMEOUT_SECONDS=20
STREAM_SOURCE_PROBE_URL=http://iris-go2rtc:1984/api/streams
# Derivado automaticamente como 1 / STREAM_CAPTURE_INTERVAL_SECONDS.
PIPELINE_CHECKS_PER_SECOND=0.333
PIPELINE_SINGLE_FACE=false
PIPELINE_SAVE_FACE_CROP=true
PIPELINE_FACE_CROP_PADDING=0.25
FACE_MIN_DET_SCORE=0.65
FACE_MIN_WIDTH=48
FACE_MIN_HEIGHT=48
FACE_MIN_BLUR_SCORE=40

# Portoes de persistencia de evento. Cada evento gravado custa uma linha de
# JSONL e DOIS JPEGs. Medido na linha USB, 3,5 meses de uma camera: 491.504
# eventos, ~992 MB de JSONL e ~3,3 GB de imagem. Jose sozinho gerou 101.489
# eventos e Emanuel 52.579 -- 98% de tudo que foi identificado, duas pessoas
# sentadas na mesa. E 84,8% dos 334.761 no_match tem 48-64 px com det_score
# medíocre: nao servem para reconhecer ninguem depois.
#
# ZERO DESLIGA, e zero e o default de proposito: o ensaio de campo precisa
# gravar tudo, porque e dele que sai o rotulo para calibrar. Os numeros acima
# sao da camera USB, com outra luz. Ligar depois do ensaio, com os cortes que o
# scripts/scene_baseline.py indicar.
#
# EVENT_DEBOUNCE_SECONDS vale so para evento identificado, por (camera,sujeito).
#   no_match nunca entra: o sujeito e o mesmo vazio para todos e uma pessoa
#   suprimiria outra.
# EVENT_UNMATCHED_MIN_* valem so para no_match, e nunca para identificado:
#   pessoa conhecida vista de longe continua valendo evento.
# Oclusao nunca passa por nenhum dos dois.
EVENT_DEBOUNCE_SECONDS=0
EVENT_UNMATCHED_MIN_WIDTH=0
EVENT_UNMATCHED_MIN_DET_SCORE=0

# Visual occlusion heuristic.
# Lightweight CPU checks over the already detected face crop; no extra AI model.
VISUAL_OCCLUSION_ENABLED=true
VISUAL_OCCLUSION_SCORE_THRESHOLD=0.75
# Piso de avaliacao (metricas) e piso de veredito (suspected=True).
VISUAL_OCCLUSION_MIN_WIDTH=48
VISUAL_OCCLUSION_MIN_HEIGHT=48
# Piso de veredito. 96 vinha da camera USB, onde 99,4% dos rostos ficavam abaixo
# dele. Medido no cenario IP em 21/09/2026: 0% abaixo de 48 px, 51,1% em 48-64,
# 23,4% em 64-96 e 25,5% acima de 96. Em 64 a cobertura vai de 25,5% para ~49%.
# Nao baixar para 48 antes de ter caso rotulado de oclusao real nessa faixa.
VISUAL_OCCLUSION_VERDICT_MIN_SIZE=64
VISUAL_OCCLUSION_DARK_PIXEL_THRESHOLD=55
VISUAL_OCCLUSION_DARK_LOWER_RATIO=0.45
VISUAL_OCCLUSION_DARK_TOP_RATIO=0.60
VISUAL_OCCLUSION_MIN_SKIN_RATIO=0.12
VISUAL_OCCLUSION_SKIN_CR_MIN=133
VISUAL_OCCLUSION_SKIN_CR_MAX=173
VISUAL_OCCLUSION_SKIN_CB_MIN=77
VISUAL_OCCLUSION_SKIN_CB_MAX=127
VISUAL_OCCLUSION_DET_SCORE_MARGIN=0.08
VISUAL_OCCLUSION_SIMILARITY_GAP=0.22
VISUAL_OCCLUSION_MIN_CANDIDATE_SIMILARITY=0.35

# Onix push ingest (real-time path). Keep ONIX_PUSH_TOKEN out of git.
ONIX_PUSH_ENABLED=false
ONIX_PUSH_URL=http://<onix-host>:8000/api/viewcare/iris/internal/ingest
ONIX_PUSH_TOKEN=
ONIX_PUSH_DEVICE_UID=
ONIX_PUSH_TIMEOUT_SECONDS=10
ONIX_PUSH_QUEUE_SIZE=200
ONIX_PUSH_WORKERS=8
ONIX_PUSH_MAX_RETRIES=2
ONIX_PUSH_RETRY_DELAY_SECONDS=1.0

# --- Linha IP (docker-compose.ip-camera.yml) ---
# Perfil independente da linha USB. Nenhum valor real, URL RTSP, token ou
# biometria entra neste arquivo: os secrets ficam fora do Git.
IRIS_IP_CAMERA_ID=entrada
IRIS_IP_BASE_IMAGE=nvcr.io/nvidia/deepstream:7.1-samples-multiarch
IRIS_IP_RTSP_SECRET_FILE=/etc/iris-ip/camera_rtsp
IRIS_IP_TOKEN_SECRET_FILE=/etc/iris-ip/engine_token
IRIS_IP_GO2RTC_SECRET_FILE=/etc/iris-ip/go2rtc.yaml

# Engine de video: cadencia de inferencia e de preview.
IRIS_IP_FRAME_FORMAT=NV12
# 5 FPS, nao 10: com 3 rostos em quadro o pipeline completo mede p95 de 124,5 ms
# por frame com FACE_DET_SIZE=960. A 10 FPS o orcamento e 100 ms e frames caem de
# forma nao deterministica; a 5 FPS o orcamento e 200 ms e sobra 38%. O dwell
# time nao sofre: um rosto de 50 px em 1920 implica um quadro de ~6 m, que alguem
# a 1,4 m/s atravessa em ~4,4 s, ou 22 frames a 5 FPS, contra min_frames=2.
# Manter pareado com IRIS_IP_FACE_DET_SIZE e IRIS_IP_CAPTURE_INTERVAL_SECONDS.
IRIS_IP_OUTPUT_FPS=5
IRIS_IP_PREVIEW_FPS=5
IRIS_IP_PREVIEW_JPEG_QUALITY=85

# API de gestao: LAN apenas, com allow-list de clientes por IP.
IRIS_IP_API_BIND=127.0.0.1
IRIS_IP_API_PORT=8181
IRIS_IP_API_ALLOWED_CLIENT_IPS=127.0.0.1,<docker-gateway>,<onix-host>,<jetson-lan>

# Preview MJPEG servido pela engine. Sem autenticacao: restringir o bind.
IRIS_IP_ENGINE_PREVIEW_BIND=127.0.0.1
IRIS_IP_ENGINE_PREVIEW_PORT=1986
IRIS_IP_LAN_STREAM_URL=http://<jetson-lan>:1986/v1/preview.mjpeg
IRIS_IP_TAILSCALE_STREAM_URL=http://<jetson-tailnet>:1986/v1/preview.mjpeg

# --- Transporte alternativo por go2rtc (opcional, nao sobe por padrao) ---
# Sobe so com: docker compose -p iris-ip -f docker-compose.ip-camera.yml \
#              --profile preview up -d go2rtc
#
# Entrega o H.265 original sem reencode. Medido em 21/09/2026: 0,38 MB/s por
# espectador contra 1,63 MB/s do MJPEG, zero perda de qualidade, e impacto nulo
# no worker (4,900 -> 4,967 FPS) mesmo compartilhando o canal 101 com a engine.
#
# O bind default e loopback porque GET /api/streams expoe a credencial RTSP da
# camera. Abrir para a LAN e decisao consciente.
IRIS_IP_PREVIEW_BIND=127.0.0.1
IRIS_IP_PREVIEW_PORT=1985
#
# Com o go2rtc no ar, apontar as URLs publicas para ele e trocar o render mode.
# NAO trocar antes de: (1) validar H.265 nos navegadores da operacao e
# (2) aplicar o patch de render_mode no Onix, que hoje devolve 'mjpeg' fixo.
# IRIS_IP_LAN_STREAM_URL=http://<jetson-lan>:1985/api/stream.m3u8?src=ip_camera
# IRIS_IP_STREAM_RENDER_MODE=hls
IRIS_IP_STREAM_RENDER_MODE=mjpeg

# Worker IP. Sondagem ao DOBRO da cadencia da engine, de proposito. O contrato
# /v1/frame serve so o frame mais recente e rejeita repeticao; sondando na mesma
# taxa em que a engine produz, o jitter faz o app cair no frame ja consumido e
# medimos 4,12 de 5,0 FPS (17,7% de perda). A 0.1 contra engine de 5 FPS: 5,000
# de 5,0, perda 0,00% em 120 s. A sondagem desperdicada e barata porque a
# duplicata e rejeitada antes do decode e de qualquer inferencia.
IRIS_IP_CAPTURE_INTERVAL_SECONDS=0.1
# Tres orcamentos distintos. Deteccao e plana (~43 ms pedindo 3 ou 50 rostos);
# so landmarks+embedding escalam, a ~21 ms por rosto. p95 por frame a 5 FPS, com
# 200 ms de orcamento: 3 rostos 146,6 ms | 4 rostos 150,4 | 5 rostos 167,8 |
# 6 rostos 221,6 (estoura). Cinco e o maior que cabe com det_size 960.
# DETECT_MAX_FACES so conta quem passa, inclusive longe demais para reconhecer.
# MAX_FACES e a capacidade do tracker (memoria e IoU, nao GPU).
# MATERIALIZE_BUDGET e o teto de rostos que viram embedding por frame, e o unico
# que consome o orcamento. Tracks vivem 1,25 s, entao 5/frame alcanca ~30 tracks
# dentro de uma janela de TTL.
IRIS_IP_DETECT_MAX_FACES=20
IRIS_IP_MAX_FACES=12
IRIS_IP_MATERIALIZE_BUDGET=5
# Entrada do detector. 480 reduz o frame 1080p em 4x e entrega o rosto tipico de
# 48 px ao SCRFD como 12 px. Descarte de rosto por det_score baixo, medido em
# 120 frames reais: 11,1% a 480, 5,7% a 640, 2,3% a 960. Esse descarte e um teto
# duro sobre a taxa de identificacao, por isso 960. So cabe a 5 FPS: ver
# IRIS_IP_OUTPUT_FPS. 1280 piora. Trocar este valor forca build de engine novo.
IRIS_IP_FACE_DET_SIZE=960,960
# Retencao de 30 dias (720 h), elevada pela operacao em 21/09/2026 a partir dos
# 14 dias anteriores. Vale para capturas, recortes de rosto e evidencias.
#
# Medido no primeiro dia util cheio da linha IP (21/09/2026, segunda): 476
# capturas, 194 MB. Trinta dias corridos sao cerca de 22 dias uteis, entao ~4 GB
# contra 783 GB livres. Disco nao e o limite aqui, e a fase de recorrencia
# precisa de uma janela maior que uma semana para ver um rosto voltar.
#
# E tambem o prazo de expurgo da biometria de quem nao se cadastrou. Elevar
# alonga por quanto tempo guardamos recorte de rosto de quem passou, nunca
# consentiu e nunca foi identificado. Reveja por esse criterio, nao pelo disco:
# o disco nunca sera o que forca a decisao.
#
# MAX_CAPTURE_FILES continua como teto duro: o que estourar o teto sai antes
# dos 30 dias, entao dimensione-o para o volume do evento.
IRIS_IP_MAX_CAPTURE_FILES=100000
IRIS_IP_CAPTURE_RETENTION_HOURS=720.0

# O servico IP nao usa env_file; sem estas variaveis o container roda em
# defaults de codigo e nao publica evento algum no broker.
IRIS_IP_MQTT_PUBLISH_ENABLED=false
IRIS_IP_MQTT_PUBLISH_HOST=
IRIS_IP_MQTT_PUBLISH_PORT=1883
IRIS_IP_MQTT_PUBLISH_CLIENT_ID=
IRIS_IP_MQTT_PUBLISH_TOPIC_PREFIX=iris
IRIS_IP_MQTT_PUBLISH_QOS=1
IRIS_IP_MQTT_PUBLISH_QUEUE_SIZE=500
IRIS_IP_MQTT_PUBLISH_KEEPALIVE_SECONDS=30

# Enriquecimento visual local, desligado ate o orquestrador estar na rede
# iris-ip. Ele recebe apenas a referencia da captura ja persistida; nao bloqueia
# reconhecimento e nao substitui o veredito do Iris.
IRIS_IP_VLM_ENRICHMENT_ENABLED=false
IRIS_IP_VLM_ORCHESTRATOR_URL=http://eclusa-vlm-orchestrator:18100/v1/jobs
IRIS_IP_VLM_API_TOKEN=
IRIS_IP_VLM_PROMPT_ID=iris-scene-v1
IRIS_IP_VLM_PRIORITY=100
IRIS_IP_VLM_QUEUE_SIZE=200
IRIS_IP_VLM_SUBMIT_TIMEOUT_SECONDS=2.0
IRIS_IP_VLM_SUBMIT_MAX_RETRIES=3
IRIS_IP_VLM_SUBMIT_RETRY_DELAY_SECONDS=1.0
IRIS_IP_VLM_JOB_MAX_ATTEMPTS=8
IRIS_IP_VLM_SHARED_EVENT_ROOT=/sources/iris-events
IRIS_IP_VLM_CALLBACK_URL=
