# Runtime target: notebook | jetson
TARGET=notebook

# Camera source
CAMERA_NAME=entrada
# Notebook: webcam interna.
# Jetson: Logitech C930e ou outra USB camera.
# Alguns dispositivos USB expõem /dev/video0 e /dev/video1.
# Comece por /dev/video0 e ajuste depois de validar com `v4l2-ctl --list-devices`.
USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_INDEX=0
USB_CAMERA_WIDTH=1280
USB_CAMERA_HEIGHT=720
USB_CAMERA_FPS=10

# Frigate / MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=frigate/events
FRIGATE_URL=http://frigate:5000

# Vision app
FACE_DB_PATH=/data/faces/faces.sqlite3
FACE_MODEL_NAME=buffalo_s
FACE_MODEL_ROOT=/models/face
FACE_DET_SIZE=640,640
FACE_SIMILARITY_THRESHOLD=0.55
FACE_MAX_RESULTS=5
FACE_PROVIDERS=CPUExecutionProvider

# Worker behavior
RECOGNITION_EVENT_TYPES=end
WORKER_LOG_LEVEL=INFO
