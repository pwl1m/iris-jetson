# Runtime target: notebook | jetson
TARGET=jetson

# Camera source
CAMERA_NAME=entrada
# Notebook: webcam interna.
# Jetson: Logitech C930e ou outra USB camera.
# Alguns dispositivos USB expõem /dev/video0 e /dev/video1.
# Comece por /dev/video0 e ajuste depois de validar com `v4l2-ctl --list-devices`.
USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_INDEX=0
USB_CAMERA_INPUT_FORMAT=mjpeg
USB_CAMERA_WIDTH=1920
USB_CAMERA_HEIGHT=1080
USB_CAMERA_FPS=15

# MQTT (opcional para integracoes futuras)
MQTT_HOST=iris-mosquitto
MQTT_PORT=1883

# Vision app
FACE_DB_PATH=/data/faces/faces.sqlite3
FACE_MODEL_NAME=buffalo_m
FACE_MODEL_ROOT=/models/face
FACE_DET_SIZE=480,480
FACE_CTX_ID=0
FACE_TRT_FP16=true
FACE_TRT_ENGINE_CACHE_PATH=/data/trt-engines
FACE_SIMILARITY_THRESHOLD=0.55
FACE_MAX_RESULTS=5
FACE_PROVIDERS=TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider

# Worker behavior
WORKER_LOG_LEVEL=INFO
EVENT_LOG_PATH=/data/events/recognitions.jsonl
CAPTURE_DIR=/data/events/captures
FACE_CROP_DIR=/data/events/faces
STREAM_URL=rtsp://iris-go2rtc:8554/usb_camera
STREAM_SOURCE_KIND=rtsp
STREAM_GST_PIPELINE=
STREAM_WORKER_ENABLED=true
STREAM_CAPTURE_INTERVAL_SECONDS=1.0
STREAM_RECONNECT_DELAY_SECONDS=3.0
STREAM_JPEG_QUALITY=85
STREAM_MIN_FACE_SCORE=0.5
STREAM_MAX_CAPTURE_FILES=2000
STREAM_PREVIEW_UPDATE_INTERVAL_SECONDS=0.25
STREAM_PREVIEW_MAX_WIDTH=640
STREAM_PREVIEW_JPEG_QUALITY=70
STREAM_READER_BUFFER_SIZE=1
STREAM_SOURCE_READY_TIMEOUT_SECONDS=20
STREAM_SOURCE_PROBE_URL=http://iris-go2rtc:1984/api/streams
PIPELINE_CHECKS_PER_SECOND=1
PIPELINE_SINGLE_FACE=true
PIPELINE_SAVE_FACE_CROP=true
PIPELINE_FACE_CROP_PADDING=0.25
FACE_MIN_DET_SCORE=0.65
FACE_MIN_WIDTH=48
FACE_MIN_HEIGHT=48
FACE_MIN_BLUR_SCORE=40
CAMERA_1_ID=entrada
CAMERA_1_STREAM_URL=rtsp://iris-go2rtc:8554/usb_camera
CAMERA_1_ENABLED=true
CAMERA_2_ID=entrada_2
CAMERA_2_STREAM_URL=
CAMERA_2_ENABLED=false
